<Project>

  <Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props" />

  <PropertyGroup>
    <LsSrcPath>$(RootPath)/src</LsSrcPath>
    <LsLibPath>$(RootPath)/lib</LsLibPath>

    <SatelliteResourceLanguages Condition="'$(MSBuildProjectName)' == 'LiveSplit.ScriptableAutoSplit'">en;zh-Hans</SatelliteResourceLanguages>
    <OutputPath>$(BuildPath)/Components</OutputPath>
  </PropertyGroup>

</Project>
